{
  "name": "auserw-hlte",
  "compatibility_date": "2026-10-23",
  // Worker-Skript nur für den Online-Modus (/api/…); alles andere sind statische Dateien.
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "Lobby"] }
  ]
}
